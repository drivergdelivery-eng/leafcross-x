{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/retailer/layout,_N_T_/retailer/cart/layout,_N_T_/retailer/cart/page,_N_T_/retailer/cart"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/retailer/cart/__PAGE__",
    "/retailer/cart",
    "/retailer",
    "/_index",
    "/_head"
  ]
}